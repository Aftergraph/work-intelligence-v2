# Optional bearer authentication. When empty, local development is unauthenticated.
AFTERGRAPH_API_TOKEN=replace-me

# SQLite database path
AFTERGRAPH_DB=./data/work-intelligence.db
AFTERGRAPH_HOST=127.0.0.1
AFTERGRAPH_PORT=8087

# Optional publish-anywhere webhook map. URLs are operator-configured, never request-provided.
# AFTERGRAPH_PUBLISHERS_JSON={"renos":"https://renos.example/api/work-items"}
# AFTERGRAPH_WEBHOOK_SECRET=replace-me
